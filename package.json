{
  "name": "versa-class",
  "version": "0.1.0",
  "description": "VERSA CLASS — Desktop studio for teachers and parents to create valuable teaching materials in minutes",
  "author": "Versa",
  "main": "src/main.cjs",
  "type": "commonjs",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "test": "node --test --test-isolation=process tests/*.cjs",
    "test:layers": "node test-layers.js",
    "build": "node test-layers.js",
    "lint": "node -e \"console.log('No linter configured')\"",
    "generate:brand": "node scripts/generate-brand-assets.mjs",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.versa.class",
    "productName": "VERSA CLASS",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*",
      "**/node_modules/playwright-core/**/*",
      "**/*.node",
      "**/services/versa-book-management/**"
    ],
    "files": [
      "src/**/*",
      "renderer/**/*",
      "backend/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json",
      "python/*.py",
      "python/requirements.txt",
      "python/setup_models.sh",
      "services/versa-book-management/**/*",
      "!services/versa-book-management/.env",
      "!services/versa-book-management/.venv/**",
      "!services/versa-book-management/__pycache__/**",
      "layout_templates/**/*",
      "!tests/**/*",
      "!**/*.test.cjs",
      "!**/*.map",
      "!python/.venv*/**",
      "!python/models/**",
      "!python/__pycache__/**",
      "!python/test_*.py",
      "!scripts/dev/**/*",
      "!add_pptx_*.py",
      "!**/*.deprecated",
      "!.cursor/**",
      "!.git/**",
      "!**/.DS_Store",
      "!ARCHITECTURE-*.md",
      "!*.log"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.education",
      "identity": null,
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.1.1"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "archiver-utils": "^5.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "crc-32": "^1.2.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.3.0",
    "imagetracerjs": "^1.2.6",
    "jimp": "^1.6.1",
    "joi": "^17.13.7",
    "keytar": "^7.9.0",
    "node-cache": "^5.1.2",
    "pdf-lib": "^1.17.1",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "playwright-core": "1.62.1",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.35.4",
    "ws": "^8.21.3",
    "zip-stream": "^7.0.5"
  },
  "allowScripts": {
    "keytar@7.9.0": true,
    "electron@39.8.10": true
  }
}
