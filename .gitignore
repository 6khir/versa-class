# Same iCloud-eviction guard as the Python venv: a synced Desktop corrupts installed
# packages in place, and the ".nosync" suffix is what iCloud Drive skips.
node_modules.nosync/
tmp-versa-asar/
.DS_Store
dist/
dist_windows/
release/*.app
release/*.zip
*.log
